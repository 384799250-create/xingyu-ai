WECOM_CORP_ID=
# 新建自建应用“小小艺 AI 客服”的 Secret；不是旧智能机器人的 Secret。
WECOM_APP_SECRET=
# 与企微“设置 API 接收”表单中保持一致。
CALLBACK_TOKEN=
CALLBACK_AES_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 配置验证、可信 IP、微信客服授权全部完成后，才启用 AI 回复。
ENABLE_AI=false
# 可选，仅处理指定 open_kfid，多个账号用英文逗号分隔。
KF_ACCOUNT_IDS=
